# Normalize source text; preserve Windows launchers on checkout.
* text=auto
*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pptx binary
